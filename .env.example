# ===========================================================================
# Mesira — variables de entorno
#
# Copiá este archivo a .env.local y completá los valores reales.
# .env.local está en .gitignore y NUNCA debe subirse al repositorio.
#
# En producción, estos mismos valores se cargan en Vercel:
#   Settings -> Environment Variables
# ===========================================================================


# ---------------------------------------------------------------------------
# Firebase — configuración del cliente
#
# Estos valores son públicos por diseño: van dentro del bundle del navegador.
# Lo que protege la base de datos NO son estas claves, son las reglas de
# Firestore/Storage y las rutas del servidor. Ver SEGURIDAD.md.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Clave pública VAPID para notificaciones push web.
# Firebase Console -> Configuración del proyecto -> Cloud Messaging -> Certificados push web
NEXT_PUBLIC_FIREBASE_VAPID_KEY=


# ---------------------------------------------------------------------------
# Firebase Admin — SECRETO. Solo servidor.
#
# Pegá el JSON completo de la cuenta de servicio en UNA sola línea.
# Firebase Console -> Configuración -> Cuentas de servicio -> Generar nueva clave privada
#
# Si esta clave alguna vez se expone (un repo público, un chat, un log),
# hay que revocarla desde la consola de Google Cloud y generar otra.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=


# ---------------------------------------------------------------------------
# Administradores
#
# Lista de emails separados por coma que reciben acceso al panel de moderación.
# Es solo el mecanismo de arranque: lo definitivo es el custom claim `admin`,
# que se asigna con `npm run admin:set -- email@ejemplo.com`.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=


# ---------------------------------------------------------------------------
# Correo (Resend) — SECRETO. Solo servidor.
# https://resend.com/api-keys
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Mesira <alertas@mesira.net>"
EMAIL_REPLY_TO=soporte@mesira.net


# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://mesira.net
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@mesira.net
